# ============================================================
# CPCLMS Backend - Environment Variables Example (.env.example)
# ============================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (NeonDB PostgreSQL) ---
# Get your DATABASE_URL from https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- JWT Authentication ---
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Access tokens last 2 hours; refresh tokens last 7 days with Remember me and 2 hours without it.
JWT_SECRET=your_jwt_secret_here_min_16_chars
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_16_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://cpc-library.online

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Gmail SMTP ---
# Use a Gmail App Password, not your normal Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# --- Persistent profile/cover/e-book file storage (Vercel Blob) ---

BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here


# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Cookie / Security ---
COOKIE_SECRET=your_cookie_secret_here
