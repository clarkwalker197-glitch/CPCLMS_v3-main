# ============================================================
# CPCLMS Backend - Environment Variables Example (.env.example)
# ============================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (NeonDB PostgreSQL) ---
# Get your DATABASE_URL from https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- JWT Authentication ---
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_16_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_16_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Google Sign-In ---
# Create a Web OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Gmail SMTP ---
# Use a Gmail App Password, not your normal Gmail password.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- Persistent cover image storage (Vercel Blob) ---
# Set this in the backend environment for local or non-Vercel deployments.
# A Vercel-connected backend can use Vercel OIDC credentials automatically.
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=your_vercel_blob_store_id


# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Cookie / Security ---
COOKIE_SECRET=your_cookie_secret_here

